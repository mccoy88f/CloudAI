# Password di Postgres. Su Coolify lascia il riferimento magico nel compose:
# Coolify genera SERVICE_PASSWORD_POSTGRES al primo deploy.
SERVICE_PASSWORD_POSTGRES=change-me

# Chiave per sessioni e segreti cifrati (GitHub App, motori).
# Su Coolify viene generata come SERVICE_PASSWORD_APP. Non cambiarla dopo
# il primo avvio: i segreti già salvati non si rileggono più.
SERVICE_PASSWORD_APP=change-me-app-secret

# Dominio pubblico dell'interfaccia, senza schema. Coolify lo assegna da solo
# se la variabile è vuota. In locale non serve.
SERVICE_FQDN_WEB_80=localhost

# Dominio delle preview, senza schema e senza asterisco. Deve essere lo stesso
# valore salvato nel wizard. Non mettere *.dominio nel campo dominio di Coolify:
# il compose aggiunge un solo router HostRegexp sul runner.
PREVIEW_DOMAIN=preview.invalid

# Porta pubblicata solo da docker-compose.local.yml
WEB_PORT=8080
